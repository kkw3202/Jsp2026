<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>회원가입 처리</title>
</head>
<body>
	<% 
	request.setCharacterEncoding("UTF-8"); 
	
	// requestJoin.jsp에 입력된 정보를 Request객체를 통해 정보를 꺼내오시오.
	
	String id = request.getParameter("id");
	String pass = request.getParameter("pass");
	String passchk = request.getParameter("passchk");
	String email = request.getParameter("email");
	String tel = request.getParameter("tel");
	String[] hobby = request.getParameterValues("hobby");
	String job = request.getParameter("job");
	String age = request.getParameter("age");
	String info = request.getParameter("info");
	
	String prtHobby = "";
	for(String a : hobby)  prtHobby += a + "/";
	boolean prtOk = false;

	// 예외처리
	if(id.equals("") || pass.equals("") || passchk.equals("") || email.equals("") || tel.equals("") || prtHobby.equals("") || 
			job.equals("") || age.equals("") || info.equals("")) out.print("<p>미기입 된 항목이 존재합니다.</p>");
	else if(!pass.equals(passchk)) out.print("<p>비밀번호가 비밀번호 확인과 일치하지 않습니다.</p>");
	else %>

		<table>
			<tr>
				<th>아이디</th>
				<td><%= id %></td>
			</tr>
			<tr>
				<th>비밀번호</th>
				<td><%= pass %></td>
			</tr>
			<tr>
				<th>비밀번호 확인</th>
				<td><%= passchk %></td>
			</tr>
			<tr>
				<th>이메일</th>
				<td><%= email %></td>
			</tr>
			<tr>
				<th>전화번호</th>
				<td><%= tel %></td>
			</tr>
			<tr>
				<th>취미</th>
				<td><%= prtHobby %></td>
			</tr>
			<tr>
				<th>직업</th>
				<td><%= job %></td>
			</tr>
			<tr>
				<th>나이</th>
				<td><%= age %></td>
			</tr>
			<tr>
				<th>남기는 말</th>
				<td><%= info %></td>
			</tr>
		</tbody>
	</table>
	

	
</body>
</html>