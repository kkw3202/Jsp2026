<body>
	<!-- 선언문 작성하는 방법 -->
	<!-- 선언문을 통해 작성한 메소드, 변수는 멤버메소드, 멤버변수가 된다. -->
	<%! public void inCremment(){}; %>
	<!-- 이하 선언문은 전역 또는 멤버 변수이다. -->
	<%! int k = 0; %>
	<!-- 이하 스크립트릿은 지역변수가 된다 -->
	<% int k = 0;%>
	
	<h2>멤버 메소드와 멤버 변수</h2>
	<%!
		String str = "선언 예제";
		/* 연산자 처리 메소드 생성 */
		public double cal(double num1, double num2, String op){
			double result = 0.0;
			if(op.equals("+")){
				result = num1 + num2;
			}else if(op.equals("-")){
				result = num1 - num2;
			}else if(op.equals("*")){
				result = num1 * num2;
			}else if(op.equals("/")){
				result = num1 / num2;
			}
			return result;
		}
	
	%>
	
	<h2>출력문</h2>
	<hr/>
	10 + 5 = <%= cal(10, 5, "+")%>
	<br/>
	10 - 5 = <%= cal(10, 5, "-")%>
	<br/>
	10 * 5 = <%= cal(10, 5, "*")%>
	<br/>
	10 / 5 = <%= cal(10, 5, "/")%>
	<br/>
	
	<!-- 배열 -->
	<h2>배열</h2>
	<%
		String arr[] = {"java","HTML","CSS","JavaScript"};
		for(int i = 0; i<arr.length; i++){
			/* 표현식 스크립트 문법을 사용하지않고 브라우저에 출력하는 방법 */
			out.print(arr[i]+"<br/>")
		}
	
	%>
</body>
