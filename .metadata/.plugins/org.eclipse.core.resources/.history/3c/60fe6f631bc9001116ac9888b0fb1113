<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
<style type="text/css">
	table{
		margin: 100px auto;
	}
</style>
</head>
<body>
	<%! 
	String[] names = {"김철수", "이영희", "박민수", "최지우", "정다은"};
	int[] scores = {92, 78, 55, 85, 67};
	%>
	<table border="1px">
		<thead>
			<tr>
				<th>번호</th>
				<th>이름</th>
				<th>점수</th>
				<th>등급</th>
				<th>그래프</th>
			</tr>
		</thead>
		<tbody>
		<%! public char grade(int score){
			return (score >= 90 ?  'A' :
						score >= 80 ? 'B' : 
							score >= 70 ? 'C' : 
								score >= 60 ? 'D' : 'F');
		}
		 %>
			<% 
			for(int i = 0; i<names.length; i++){
				out.print("<tr>");
					out.print("<td>"+(i+1)+"</td>");
					out.print("<td>"+names[i]+"</td>");
					out.print("<td>"+scores[i]+"</td>");
					out.print("<td>"+ grade(scores[i]) +"</td>");
					out.print("<td><div style='width:" + "'" + "></div></td>");
					
			
				out.print("</tr>");
			}
			%>
		</tbody>
	</table>
</body>
</html>