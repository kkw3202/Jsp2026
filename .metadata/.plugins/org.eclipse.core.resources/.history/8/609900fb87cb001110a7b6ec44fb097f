<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>회원가입</title>
</head>
<body>
<div class="container">
		<h2>회원가입</h2>
		<form action="RequestJoinProc.jsp" method="post">
			<table width="500" border="1">
				<tr height="50">
					<td align="center" width="150">아이디</td>
					<td width="350">
						<input type="text" name="id" placeholder="아이디를 입력하세요"/>
					</td>
				</tr>	
				<tr height="50">
					<td align="center" width="150">비밀번호</td>
					<td width="350">
						<input type="password" name="pass" placeholder="영문/숫자로만 입력하세요"/>
					</td>
				</tr>	
				<tr height="50">
					<td align="center" width="150">비밀번호</td>
					<td width="350">
						<input type="password" name="passchk" placeholder="영문/숫자로만 입력하세요"/>
					</td>
				</tr>	
				<tr height="50">
					<td align="center" width="150">이메일</td>
					<td width="350">
						<input type="email" name="email" placeholder="@를 포함하여 입력하세요"/>
					</td>
				</tr>	
				<tr height="50">
					<td align="center" width="150">전화번호</td>
					<td width="350">
						<input type="tel" name="tel" placeholder="010-0000-0000 형식으로 입력하세요"/>
					</td>
				</tr>
				<tr height="50">
					<td align="center" width="150">관심분야</td>
					<td width="350">
						<input type="tel" name="tel" placeholder="010-0000-0000 형식으로 입력하세요"/>
					</td>
				</tr>
			</table>
		</form>
	
	</div>
</body>
</html>